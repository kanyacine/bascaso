# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/

# production
/build

# env – everything but the template
.env*
!.env.example

# data
/data

# misc
.DS_Store
.superset
*.pem

# script output
/scripts/output/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# electron
/out/
electron/*.js
electron/*.js.map

# supabase CLI – linked-project.json carries the project ref and nothing
# ignored it, so a `git add .` would have committed it
/supabase/.temp/

# personal/internal working docs – never committed to this public repo
/docs/superpowers/
/.claude/
/.superpowers/
